<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <title>GameAdd</title>

  <link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">

  <style>
    body {
      background: #000;
      font-family: "Press Start 2P", monospace;
      color: white;
      text-align: center;
      margin: 0;
      overflow: hidden;
    }

    .logo {
      font-size: 26px;
      color: #ff2b2b;
      margin-bottom: 15px;
      text-shadow: 3px 3px 0 #600;
    }

    .screen {
      display: none;
      min-height: 100vh;
      justify-content: center;
      align-items: center;
      flex-direction: column;
      opacity: 0;
      transition: opacity 0.5s;
    }

    .active {
      display: flex;
      opacity: 1;
    }

    .gameboy {
      background: #cfcfcf;
      width: 320px;
      height: 480px;
      border-radius: 20px;
      padding: 20px;
      box-shadow: 0 0 30px black;
    }

    .display {
      background: #0f380f;
      color: #8bac0f;
      width: 100%;
      height: 230px;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      margin-bottom: 40px;
    }
    .readme-body {
      text-align: left;
      font-size: 12px;
      line-height: 1.8;
      max-height: 250px;
      overflow-y: auto;
      margin-bottom: 10px;
    }

    .gb-item {
      text-align: left;
      margin: 10px 0;
    }

    .gb-item.active {
      animation: blink 1s infinite;
    }

    .gb-buttons {
      display: flex;
      justify-content: center;
      margin-top: 20px;
    }

    .btn {
      background: #a30000;
      width: 45px;
      height: 45px;
      border-radius: 50%;
      line-height: 45px;
      font-weight: bold;
      cursor: pointer;
    }

    .dq-box {
      border: 4px solid white;
      padding: 25px;
      width: 85%;
    }

    .dq-choice {
      text-align: left;
      margin: 14px 0;
      cursor: pointer;
    }

    .back-btn {
      margin-top: 20px;
      padding: 10px 20px;
    }

    @keyframes blink {
      0%, 50%, 100% { opacity: 1; }
      25%, 75% { opacity: 0.3; }
    }
  </style>
</head>

<body>

<!-- ✅ トップ画面 -->
<div id="top" class="screen active">
  <div class="gameboy">

    <div class="display">
      <div class="logo">GameAdd</div>
      <div class="gb-item active">▶ START</div>
      <div class="gb-item">　OPTION</div>
    </div>

    <div class="gb-buttons">
      <div class="btn" id="btnA">A</div>
    </div>
  </div>
</div>

<!-- ✅ OPTION画面 -->
<div id="option" class="screen">
  <div class="dq-box">
    <div class="dq-title">📖 GameAdd README</div>

    <div class="readme-body">
      <p>■ このアプリについて</p>
      <p>気分に応じてゲームを自動で紹介するアプリです。</p>

      <p>■ 操作方法</p>
      <p>↑ ↓：カーソル移動</p>
      <p>A / Enter：決定</p>

      <p>■ 使用技術</p>
      <p>HTML / CSS / JavaScript / Rails</p>

      <p>■ 制作</p>
      <p>Runrun</p>
    </div>

    <button class="back-btn" onclick="goTop()">▶ もどる</button>
  </div>
</div>


<!-- ✅ 気分選択 -->
<div id="mood" class="screen">
  <div class="dq-box">
    <div class="dq-choice" onclick="selectMood('ガンガン行こうぜ')">▶ ガンガン行こうぜ</div>
    <div class="dq-choice" onclick="selectMood('いのちだいじに')">▶ いのちだいじに</div>
    <button class="back-btn" onclick="goTop()">▶ もどる</button>
  </div>
</div>

<!-- ✅ 結果 -->
<div id="result" class="screen">
  <div class="dq-box">
    <p id="selectedMood"></p>
    <button class="back-btn" onclick="goTop(true)">▶ トップへ</button>
  </div>
</div>

<script>
  const audioCtx = new (window.AudioContext || window.webkitAudioContext)();

  function playSE(freq = 800, time = 0.1) {
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = "square";
    osc.frequency.value = freq;
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start();
    gain.gain.exponentialRampToValueAtTime(0.0001, audioCtx.currentTime + time);
    osc.stop(audioCtx.currentTime + time);
  }

  // ✅ 画面DOMを明示的に取得（ここが今回の致命点）
  const topScreen = document.getElementById("top");
  const moodScreen = document.getElementById("mood");
  const optionScreen = document.getElementById("option");
  const resultScreen = document.getElementById("result");

  let index = 0;
  const items = document.querySelectorAll(".gb-item");

  function updateCursor() {
    items.forEach((item, i) => {
      item.classList.toggle("active", i === index);
      item.innerHTML = (i === index ? "▶ " : "　") + item.textContent.replace("▶", "").trim();
    });
  }

  document.addEventListener("keydown", (e) => {
    if (!topScreen.classList.contains("active")) return;

    if (e.key === "ArrowDown" || e.key === "ArrowUp") {
      playSE(400, 0.05);
      index = (index + 1) % 2;
    }

    if (e.key === "Enter") {
      playSE(900, 0.15);
      index === 0 ? goMood() : goOption();
    }

    updateCursor();
  });

  document.getElementById("btnA").onclick = () => {
    playSE(900, 0.15);
    index === 0 ? goMood() : goOption();
  };

  function goMood() {
    topScreen.classList.remove("active");
    moodScreen.classList.add("active");
  }

  function goOption() {
    topScreen.classList.remove("active");
    optionScreen.classList.add("active");
  }

function selectMood(moodText) {
  playSE(1100, 0.1);
  moodScreen.classList.remove("active");
  resultScreen.classList.add("active");

  document.getElementById("selectedMood").innerText = moodText;
  document.getElementById("selectedMood").insertAdjacentHTML("afterend", "<p id='gameResult'>読み込み中...</p>");

  // ✅ Railsへ気分を送信して結果取得
  fetch(`/games/result?mood=${encodeURIComponent(moodText)}`)
    .then(res => res.json())
    .then(data => {
      document.getElementById("gameResult").innerText = data.result;
    })
    .catch(() => {
      document.getElementById("gameResult").innerText = "エラーが発生しました";
    });
}


  function goTop(sound = false) {
    if (sound) playSE(500, 0.2);
    document.querySelectorAll(".screen").forEach(s => s.classList.remove("active"));
    topScreen.classList.add("active");
  }

  updateCursor();
</script>

</body>
</html>
