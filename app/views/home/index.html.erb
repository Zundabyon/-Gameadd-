<!DOCTYPE html>
<html lang="ja">
<head>
<meta charset="UTF-8">
<title>GameAdd</title>
<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap" rel="stylesheet">
<style>
body {
  background:black;
  margin:0;
  font-family:"Press Start 2P", monospace;
  color:white;
  overflow:hidden;
}

.gameboy {
  width:340px;
  height:540px;
  margin:5vh auto;
  background:#cfcfcf;
  border-radius:30px;
  box-shadow: inset 0 0 20px #888,0 0 30px black;
  padding:20px;
  position:relative;
}

.logo {
  text-align:center;
  font-size:18px;
  color:#ff2b2b;
  margin-bottom:10px;
}

.display {
  background:#0f380f;
  color:#8bac0f;
  width:100%;
  height:230px;
  padding:10px;
  overflow:hidden;
  box-sizing:border-box;
}

.buttons {
  position:absolute;
  bottom:70px;
  right:25px;
  display:flex;
  gap:18px;
}

.btn {
  background:#a30000;
  width:42px;
  height:42px;
  border-radius:50%;
  display:flex;
  align-items:center;
  justify-content:center;
  font-weight:bold;
  font-size:16px;
  color:white;
  cursor:pointer;
}

.dpad {
  position:absolute;
  bottom:80px;
  left:20px;
  width:90px;
  height:90px;
}

.dpad-btn {
  position:absolute;
  background:#444;
  width:28px;
  height:28px;
  border-radius:6px;
  cursor:pointer;
}
.dpad-up{top:0; left:31px;}
.dpad-down{bottom:0; left:31px;}
.dpad-left{left:0; top:31px;}
.dpad-right{right:0; top:31px;}
</style>
</head>
<body>

<div class="gameboy">
  <div class="logo">GameAdd</div>
  <div class="display" id="display"></div>

  <div class="buttons">
    <div class="btn" id="btnA">A</div>
    <div class="btn" id="btnB">B</div>
  </div>

  <div class="dpad">
    <div class="dpad-btn dpad-up" id="up"></div>
    <div class="dpad-btn dpad-down" id="down"></div>
    <div class="dpad-btn dpad-left" id="left"></div>
    <div class="dpad-btn dpad-right" id="right"></div>
  </div>
</div>

<script>
// ==================== 音関連 ====================
const audioCtx = new (window.AudioContext||window.webkitAudioContext)();

function playSE(freq=600,time=0.1){
  const osc=audioCtx.createOscillator();
  const gain=audioCtx.createGain();
  osc.type="square";
  osc.frequency.value=freq;
  osc.connect(gain);
  gain.connect(audioCtx.destination);
  osc.start();
  gain.gain.exponentialRampToValueAtTime(0.0001,audioCtx.currentTime+time);
  osc.stop(audioCtx.currentTime+time);
}

// ドラクエ風3音和音BGM
let bgmStarted=false;
function startBGM(){
  if(bgmStarted) return;
  bgmStarted=true;

  const melody =[262,294,330,349,392,349,330,294];
  const chord2 =[196,220,247,262,294,262,247,220];
  const bass   =[131,147,165,175,196,175,165,147];
  let i=0;

  function loop(){
    [melody, chord2, bass].forEach((line,idx)=>{
      const osc=audioCtx.createOscillator();
      const gain=audioCtx.createGain();
      osc.type="square";
      osc.frequency.value=line[i%line.length];
      gain.gain.value= idx===0 ? 0.2 : 0.12;
      osc.connect(gain);
      gain.connect(audioCtx.destination);
      osc.start();
      osc.stop(audioCtx.currentTime+0.25);
    });
    i++;
    setTimeout(loop,250);
  }
  loop();
}

// ==================== ゲーム制御 ====================
let scene="top";
let cursor=0;
let selectedMood="";
let resultData=null;

const moods=[
  "ガンガンいこうぜ",
  "ばっちりがんばれ",
  "いのちだいじに",
  "じゅもんつかうな",
  "おれにまかせろ"
];

const game_map={
  "ガンガンいこうぜ":["モンスターハンター","爽快アクションでストレス発散"],
  "ばっちりがんばれ":["スプラトゥーン","対戦で実力勝負"],
  "いのちだいじに":["どうぶつの森","癒しとスローライフ"],
  "じゅもんつかうな":["ゼルダの伝説","骨太アクション冒険"],
  "おれにまかせろ":["FF","仲間と戦略バトル"]
};

function maxCursor(){
  if(scene==="top") return 2;
  if(scene==="mood") return 5;
  return 1;
}

function draw(){
  const d=document.getElementById("display");
  if(scene==="top"){
    d.innerHTML=`
    ${cursor===0?"▶":"　"} START<br>
    ${cursor===1?"▶":"　"} OPTION
    `;
  }

  if(scene==="mood"){
    d.innerHTML=moods.map((m,i)=>
      `${cursor===i?"▶":"　"} ${m}`
    ).join("<br>") + `<br><br>◀ B もどる`;
  }

  if(scene==="result"){
    d.innerHTML=`
    ▶ 結果<br>
    気分：${selectedMood}<br><br>
    おすすめ：${resultData[0]}<br>
    理由：${resultData[1]}<br><br>
    ◀ B トップへ
    `;
  }

  if(scene==="option"){
    d.innerHTML=`
    📖 README　 METAPPI作<br><br>
    ゲームをおすすめするミニミニアプリです。<br>
    <br>今後は画像表示やデータベース連携　　　　ランダムで結果を表示する機能を追加予定です。</br>
    十字キー：移動<br>
    A：決定　B：戻る<br><br>
    ◀ B もどる
    `;
  }
}

function decide(){
  startBGM();
  playSE(900);

  if(scene==="top"){
    scene= cursor===0 ? "mood" : "option";
    cursor=0;
  } 
  else if(scene==="mood"){
    selectedMood=moods[cursor];
    resultData=game_map[selectedMood];
    scene="result";
  } 
  else {
    scene="top";
    cursor=0;
  }
  draw();
}

function back(){
  playSE(400);
  if(scene==="mood" || scene==="option"){
    scene="top";
  } else if(scene==="result"){
    scene="mood";
  }
  cursor=0;
  draw();
}

// ==================== 操作 ====================
document.addEventListener("keydown",e=>{
  startBGM();
  if(e.key==="ArrowUp"){playSE(300);cursor=(cursor-1+maxCursor())%maxCursor();}
  if(e.key==="ArrowDown"){playSE(300);cursor=(cursor+1)%maxCursor();}
  if(e.key==="Enter") decide();
  if(e.key==="Escape"||e.key==="Backspace") back();
  draw();
});

btnA.onclick=decide;
btnB.onclick=back;
up.onclick=()=>{playSE(300);cursor=(cursor-1+maxCursor())%maxCursor();draw();}
down.onclick=()=>{playSE(300);cursor=(cursor+1)%maxCursor();draw();}
left.onclick=back;
right.onclick=decide;

draw();
</script>
</body>
</html>
